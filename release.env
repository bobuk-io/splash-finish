# Release facts of Splash Finish for the shared kit in Scripts/release (see Scripts/release/README.md).
APP_NAME="Splash Finish"
APP_EXECUTABLE=SplashFinish
BUNDLE_ID=io.bobuk.splash-finish
ARCHIVE_PREFIX=SplashFinish
# install.py and Homebrew read this manifest name.
CHECKSUMS_FILE=SHA256SUMS
INSTALL_DIR=/Applications
GITHUB_REPO=bobuk-io/splash-finish
LANDING_SLUG=splash-finish
SPARKLE_ACCOUNT=io.bobuk.splash-finish
SPARKLE_PUBLIC_KEY=UgU/VhTFdMVMUUwDG2TYW+cvn6ruGpfsdI82c02GdrA=
# Splash Finish 0.3.12 and older read the feed from the latest GitHub release.
GITHUB_APPCAST=1
HOMEBREW_CASK=splash-finish
EXTRA_TESTS="python3 -m unittest discover -s Tests && node Tests/pi-extension.test.mjs && node Tests/pi-questions.test.mjs && node Tests/omp-extension.test.mjs && bash Vendor/BobukKit/Scripts/check-vendor.sh"
BUNDLE_CHECK=Tests/test_packaged_resources.py
# Packaging with Scripts/release/package.sh (see Scripts/release/README.md, "Packaging").
PACKAGE_ARCHES="arm64 x86_64"
PACKAGE_CATEGORY=public.app-category.developer-tools
PACKAGE_ICON=Scripts/render_icon.swift
PACKAGE_RESOURCES=
# Development copies read the feed too, as Splash Finish always did.
PACKAGE_SPARKLE_IN_DEBUG=1
